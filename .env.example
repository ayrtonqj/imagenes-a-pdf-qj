# Configuration for Image to PDF Converter
# Copy this file to .env and adjust values

# Default page size: A4, Letter, Legal, or Original (uses image dimensions)
PAGE_SIZE=A4

# Orientation: Portrait or Landscape
ORIENTATION=Portrait

# Image quality (1-100) - only used when img2pdf is not available
QUALITY=95

# Default output directory
OUTPUT_DIR=.

# Default output filename (without extension)
OUTPUT_FILENAME=output
